{
  "name": "fuel/kabooodle",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kabooodle/tiny-php"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kabooodle/cashier"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kabooodle/iron-queue"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kabooodle/Laravel-HTMLMin"
    }
  ],
  "require": {
    "php": ">=5.5.9 || ^7.0",
    "algolia/algoliasearch-laravel": "1.2.2",
    "alt-three/bus": "1.1.0",
    "aws/aws-sdk-php-laravel": "3.1.0",
    "barryvdh/laravel-cors": "0.8.1",
    "barryvdh/laravel-ide-helper": "2.2.1",
    "bugsnag/bugsnag-laravel": "2.4.0",
    "dingo/api": "1.0.*@dev",
    "emojione/emojione": "2.2.6",
    "fideloper/proxy": "^3.1",
    "graham-campbell/binput": "3.4.0",
    "graham-campbell/htmlmin": "4.5.1",
    "helpscout/api": "^1.8",
    "laravel/cashier": "6.0.19",
    "laravel/framework": "5.2.31",
    "laravelcollective/html": "5.2.4",
    "laravelcollective/iron-queue": "^5.2",
    "league/flysystem-aws-s3-v3": "1.0.13",
    "maatwebsite/excel": "~2.1.0",
    "nexmo/client": "@beta",
    "nexmo/laravel": "1.0.0-beta3",
    "predis/predis": "1.1.0",
    "ramsey/uuid": "3.5.0",
    "rtconner/laravel-tagging": "2.2.0",
    "sammyk/laravel-facebook-sdk": "^3.4.0",
    "shippo/shippo-php": "1.1.1",
    "sofa/revisionable": "5.2.1",
    "spatie/laravel-fractal": "1.9.1",
    "tymon/jwt-auth": "1.0.*@dev",
    "wildbit/laravel-postmark-provider": "3.0.0",
    "zackkitzmiller/tiny": "1.2.2",
    "vinkla/pusher": "^2.4",
    "jonnypickett/eloquent-sti": "^1.0",
    "spatie/laravel-newsletter": "^3.4"
  },
  "require-dev": {
    "alt-three/testbench": "^1.8",
    "fzaninotto/faker": "~1.4",
    "mockery/mockery": "0.9.*",
    "phpunit/phpunit": "5.2.9",
    "symfony/css-selector": "2.8.*|3.0.*",
    "symfony/dom-crawler": "2.8.*|3.0.*",
    "barryvdh/laravel-debugbar": "2.2.2"
  },
  "autoload": {
    "classmap": [
      "resources/database"
    ],
    "psr-4": {
      "Kabooodle\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kabooodle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "php artisan optimize"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "github-oauth": {
      "github.com": "940518d694316861963030a87ad682004bda7e07"
    }
  },
  "minimum-stability": "dev"
}
